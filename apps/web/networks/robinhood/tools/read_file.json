{
  "name": "read_file",
  "description": "Read a text file inside the project. Returns numbered lines.",
  "parameters": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Path relative to the project root"
      },
      "offset": {
        "type": "integer",
        "description": "First line to read, 1-based"
      },
      "limit": {
        "type": "integer",
        "description": "Number of lines, default 2000"
      }
    },
    "required": [
      "path"
    ]
  },
  "approval": "none",
  "version": "3.0.0"
}
